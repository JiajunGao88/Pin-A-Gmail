{
    "manifest_version": 3,
    "name": "Gmail Pin Extension",
    "description": "在Gmail中添加邮件置顶功能",
    "version": "1.0",
    "icons": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "permissions": [
      "storage"
    ],
    "host_permissions": [
      "https://mail.google.com/*"
    ],
    "content_scripts": [{
      "matches": ["https://mail.google.com/*"],
      "css": ["styles.css"],
      "js": ["content.js"]
    }]
  }